# Tool pins: the ONE file the devcontainer image and the Makefile both read.
#
# The Makefile includes it; the image's tools stage reads it while installing
# the toolchain, so the tools in the image are the tools the Makefile names
# and a bump is one edit. Plain KEY=value lines only, because make and sh must
# read them identically: no quoting, no expansion, no spaces around "=".
#
# Bumping a pin is a deliberate change, one issue per bump. ci.yml asserts the
# scanner pins against the binaries it runs, so a bump here is a bump there.

GOLANGCI_LINT_VERSION=v2.14.0
GOSEC_VERSION=v2.29.0
# gosec is built against this x/tools: the v0.49.0 its go.mod names cannot read
# the export data (version 5) Go 1.27 writes, so every import fails to type-check.
XTOOLS_VERSION=v0.52.0
GOVULNCHECK_VERSION=v1.8.0
ACTIONLINT_VERSION=v1.7.12

# The Go language server .devcontainer/devcontainer.json enables. The image
# sets GOPROXY=off, so an editor cannot fetch it on first open: it is
# installed with the rest, at this pin.
GOPLS_VERSION=v0.24.0

# trivy is a pinned release archive, verified before it is unpacked: the
# archive per architecture (upstream's trivy_0.75.0_checksums.txt) and the
# binary inside it, raised together or not at all.
TRIVY_VERSION=v0.75.0
TRIVY_SHA256_LINUX_AMD64=c6e65abddb348e25f10549df887045629cf28cc72453cd1c63acb717316b3f3f
TRIVY_SHA256_LINUX_ARM64=a1ee9f6ffb7d112b64ff726a2a0717c21175c1114361391f4a132956751a13b3
TRIVY_BIN_SHA256_LINUX_AMD64=93f9da8e4ba5e0c1c76d8234ed2494cf9afb0a96fd21953e424bb795f3299b8e
TRIVY_BIN_SHA256_LINUX_ARM64=869e310e208f0f2e3e90e4f842cc6adaa2b2c046fecbaade481e6b23fcc8f2a9
